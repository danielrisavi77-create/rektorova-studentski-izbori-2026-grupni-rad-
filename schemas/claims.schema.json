{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim-to-Evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "claims"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "hypothesis", "class", "title", "claim", "status", "paper", "web_anchor"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9'-]+$"},
          "hypothesis": {"type": "string", "minLength": 1},
          "class": {"enum": ["confirmatory", "confirmatory-partial", "exploratory"]},
          "title": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "paper": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "web_anchor": {"type": "string", "pattern": "^#"}
        }
      }
    }
  }
}
